# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster URL with your MongoDB Atlas details:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DB_NAME=ProjectGuide-AI

# Groq API Keys
# You can supply a single shared GROQ_API_KEY, or separate dedicated keys per agent:
GROQ_API_KEY=gsk_your_shared_groq_api_key_here
GROQ_API_KEY_FEASIBILITY=gsk_your_feasibility_agent_key_here
GROQ_API_KEY_SCOPE=gsk_your_scope_agent_key_here
GROQ_API_KEY_TECH_STACK=gsk_your_tech_stack_agent_key_here
GROQ_API_KEY_RISK=gsk_your_risk_agent_key_here

# Groq Model (default: groq/llama-3.3-70b-versatile)
GROQ_MODEL=groq/llama-3.3-70b-versatile

