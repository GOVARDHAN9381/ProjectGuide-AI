{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://projectguide-ai-backend.onrender.com/api/:match*"
    },
    {
      "source": "/onboarding",
      "destination": "https://projectguide-ai-backend.onrender.com/onboarding"
    },
    {
      "source": "/submit-idea",
      "destination": "https://projectguide-ai-backend.onrender.com/submit-idea"
    },
    {
      "source": "/faculty/:match*",
      "destination": "https://projectguide-ai-backend.onrender.com/faculty/:match*"
    },
    {
      "source": "/mentor/:match*",
      "destination": "https://projectguide-ai-backend.onrender.com/mentor/:match*"
    },
    {
      "source": "/documents/:match*",
      "destination": "https://projectguide-ai-backend.onrender.com/documents/:match*"
    },
    {
      "source": "/health",
      "destination": "https://projectguide-ai-backend.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
